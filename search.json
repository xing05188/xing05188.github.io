---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title":    {{ post.title | jsonify }},
    "url":      {{ post.url | relative_url | jsonify }},
    "date":     {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "category": {{ post.categories.first | default: "" | jsonify }},
    "tags":     {{ post.tags | jsonify }},
    "excerpt":  {{ post.excerpt | strip_html | strip_newlines | collapse_whitespace | jsonify }},
    "content":  {{ post.content | strip_html | strip_newlines | collapse_whitespace | truncate: 3000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
